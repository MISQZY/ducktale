# ──────────────────────────────────────────────
# Database (MariaDB / MySQL via Prisma)
# ──────────────────────────────────────────────
DATABASE_URL=

# Site-owned data (user accounts, Minecraft account links). Separate
# database from every plugin DB above — see src/prisma/site/schema.prisma.
DATABASE_URL_SITE=

# Prefix applied to every table in the site DB, e.g. "site_" -> site_user,
# site_account_link (see src/prisma/site/schema.prisma.template). Must match
# the Minecraft plugin's config.yml database.table-prefix. Empty is fine too.
SITE_DB_TABLE_PREFIX=

# Signs Auth.js session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public site origin, used for metadataBase/OpenGraph and absolute links.
NEXT_PUBLIC_SITE_URL=https://ducktale.online

# Source repo for "Edit this page on GitHub" links and last-modified
# attribution (see src/config/site.ts -> REPO, src/lib/github.ts).
GITHUB_REPO=your-org/ducktale
GITHUB_REPO_BRANCH=master

# Max upload size (in MB) for ticket attachments. Clamped to 1-50 (see
# src/lib/tickets.ts and next.config.mjs) — this is also the request-body
# ceiling for EVERY Server Action in the app, not just ticket ones, so the
# default is intentionally conservative.
MAX_TICKET_ATTACHMENT_MB=20

# Optional: raises the GitHub REST API rate limit for last-modified lookups.
# A classic PAT with no scopes is enough for public repos.
GITHUB_TOKEN=

# Shared secret for server-to-server calls from trusted Minecraft plugins
# (e.g. POST /api/badges/award), sent as "Authorization: Bearer <secret>".
# Generate with: openssl rand -base64 32
PLUGIN_API_SECRET=

# Web Push (src/lib/push.ts) — generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is served to the browser via GET /api/push/public-key (not
# NEXT_PUBLIC_*, to avoid keeping two copies of the same value in sync).
# VAPID_SUBJECT must be a mailto: or https: URL the push service can contact
# if it needs to reach the site operator about abuse.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@misqzy.net
