  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx && prisma generate --schema=src/prisma/schema.prisma",
    "dev": "next dev",
    "build": "npm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:pull": "prisma db pull --schema=src/prisma/schema.prisma",
