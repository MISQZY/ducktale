    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.11.5",
    "isomorphic-dompurify": "^3.22.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-intl": "^4.5.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
