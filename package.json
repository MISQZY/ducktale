{
  "name": "ducktale",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "fumadocs-mdx && prisma generate --schema=src/prisma/schema.prisma && npm run site-db:render && prisma generate --schema=src/prisma/site/schema.prisma",
    "dev": "next dev",
    "build": "npm run lint && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:pull": "prisma db pull --schema=src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=src/prisma/schema.prisma",
    "site-db:render": "node scripts/render-site-schema.js",
    "site-db:push": "npm run site-db:render && prisma db push --schema=src/prisma/site/schema.prisma",
    "site-db:migrate": "npm run site-db:render && prisma migrate dev --schema=src/prisma/site/schema.prisma",
    "site-db:generate": "npm run site-db:render && prisma generate --schema=src/prisma/site/schema.prisma",
    "site-db:studio": "npm run site-db:render && prisma studio --schema=src/prisma/site/schema.prisma"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@antv/x6-react-shape": "^3.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@orama/tokenizers": "^3.1.18",
    "@prisma/client": "^6.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.11.5",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.11.5",
    "isomorphic-dompurify": "^3.22.0",
    "js-yaml": "^5.2.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.5.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
