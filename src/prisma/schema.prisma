generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model fp_fcolor {
  id               Int                @id @default(autoincrement())
  name             String             @db.MediumText
  fp_player_fcolor fp_player_fcolor[]
}

model fp_ignore {
  id                                       Int       @id @default(autoincrement())
  date                                     BigInt
  initiator                                Int
  target                                   Int
  valid                                    Int       @default(1)
  fp_player_fp_ignore_initiatorTofp_player fp_player @relation("fp_ignore_initiatorTofp_player", fields: [initiator], references: [id], onUpdate: Restrict, map: "fp_ignore_ibfk_1")
  fp_player_fp_ignore_targetTofp_player    fp_player @relation("fp_ignore_targetTofp_player", fields: [target], references: [id], onUpdate: Restrict, map: "fp_ignore_ibfk_2")

  @@index([initiator, target, valid], map: "idx_fp_ignore_initiator_target_valid")
  @@index([initiator, valid], map: "idx_fp_ignore_initiator_valid")
  @@index([target, valid], map: "idx_fp_ignore_target_valid")
}

model fp_mail {
  id                                    Int       @id @default(autoincrement())
  date                                  BigInt
  sender                                Int
  receiver                              Int
  message                               String    @db.MediumText
  valid                                 Int       @default(1)
  fp_player_fp_mail_senderTofp_player   fp_player @relation("fp_mail_senderTofp_player", fields: [sender], references: [id], onUpdate: Restrict, map: "fp_mail_ibfk_1")
  fp_player_fp_mail_receiverTofp_player fp_player @relation("fp_mail_receiverTofp_player", fields: [receiver], references: [id], onUpdate: Restrict, map: "fp_mail_ibfk_2")

  @@index([receiver, valid], map: "idx_fp_mail_receiver_valid")
  @@index([receiver, valid, date], map: "idx_fp_mail_receiver_valid_date")
  @@index([sender, valid], map: "idx_fp_mail_sender_valid")
  @@index([sender, valid, date], map: "idx_fp_mail_sender_valid_date")
}

model fp_moderation {
  id                                           Int       @id @default(autoincrement())
  player                                       Int
  date                                         BigInt
  time                                         BigInt
  reason                                       String?   @db.Text
  moderator                                    Int
  type                                         String    @db.VarChar(255)
  valid                                        Int       @default(1) @db.TinyInt
  server                                       String?   @db.VarChar(255)
  fp_player_fp_moderation_playerTofp_player    fp_player @relation("fp_moderation_playerTofp_player", fields: [player], references: [id], onUpdate: Restrict, map: "fp_moderation_ibfk_1")
  fp_player_fp_moderation_moderatorTofp_player fp_player @relation("fp_moderation_moderatorTofp_player", fields: [moderator], references: [id], onUpdate: Restrict, map: "fp_moderation_ibfk_2")

  @@index([moderator], map: "idx_fp_moderation_moderator")
  @@index([player, type(length: 32), valid, time], map: "idx_fp_moderation_player_type_valid_time")
  @@index([type(length: 32), valid, time], map: "idx_fp_moderation_type_valid_time")
}

model fp_moderation_old {
  id                                               Int       @id @default(autoincrement())
  player                                           Int
  date                                             BigInt
  time                                             BigInt
  reason                                           String?   @db.MediumText
  moderator                                        Int
  type                                             Int
  valid                                            Int       @default(1)
  fp_player_fp_moderation_old_playerTofp_player    fp_player @relation("fp_moderation_old_playerTofp_player", fields: [player], references: [id], onUpdate: Restrict, map: "fp_moderation_old_ibfk_1")
  fp_player_fp_moderation_old_moderatorTofp_player fp_player @relation("fp_moderation_old_moderatorTofp_player", fields: [moderator], references: [id], onUpdate: Restrict, map: "fp_moderation_old_ibfk_2")

  @@index([moderator], map: "idx_fp_moderation_moderator")
  @@index([moderator, valid], map: "idx_fp_moderation_moderator_valid")
  @@index([player, type, valid], map: "idx_fp_moderation_player_type_valid")
  @@index([player, valid, time], map: "idx_fp_moderation_player_valid_time")
  @@index([valid, time], map: "idx_fp_moderation_valid_time")
}

model fp_player {
  id                                                       Int                 @id @default(autoincrement())
  online                                                   Int                 @default(0)
  uuid                                                     String              @unique(map: "uuid") @db.VarChar(36)
  name                                                     String              @unique(map: "name") @db.VarChar(255)
  ip                                                       String?             @db.VarChar(39)
  fp_ignore_fp_ignore_initiatorTofp_player                 fp_ignore[]         @relation("fp_ignore_initiatorTofp_player")
  fp_ignore_fp_ignore_targetTofp_player                    fp_ignore[]         @relation("fp_ignore_targetTofp_player")
  fp_mail_fp_mail_senderTofp_player                        fp_mail[]           @relation("fp_mail_senderTofp_player")
  fp_mail_fp_mail_receiverTofp_player                      fp_mail[]           @relation("fp_mail_receiverTofp_player")
  fp_moderation_fp_moderation_playerTofp_player            fp_moderation[]     @relation("fp_moderation_playerTofp_player")
  fp_moderation_fp_moderation_moderatorTofp_player         fp_moderation[]     @relation("fp_moderation_moderatorTofp_player")
  fp_moderation_old_fp_moderation_old_playerTofp_player    fp_moderation_old[] @relation("fp_moderation_old_playerTofp_player")
  fp_moderation_old_fp_moderation_old_moderatorTofp_player fp_moderation_old[] @relation("fp_moderation_old_moderatorTofp_player")
  fp_player_fcolor                                         fp_player_fcolor[]
  fp_setting                                               fp_setting[]
  fp_time                                                  fp_time?

  @@index([ip], map: "idx_fp_player_ip")
  @@index([online], map: "idx_fp_player_online")
}

model fp_player_fcolor {
  id        Int       @id @default(autoincrement())
  number    Int
  player    Int
  fcolor    Int
  type      String    @db.VarChar(255)
  fp_player fp_player @relation(fields: [player], references: [id], onUpdate: Restrict, map: "fp_player_fcolor_ibfk_1")
  fp_fcolor fp_fcolor @relation(fields: [fcolor], references: [id], onUpdate: Restrict, map: "fp_player_fcolor_ibfk_2")

  @@unique([number, player, type], map: "fp_player_fcolor_unique")
  @@index([fcolor], map: "fcolor")
  @@index([player, type(length: 100)], map: "idx_fp_player_fcolor_player_type")
  @@index([player, type(length: 100), number], map: "idx_fp_player_fcolor_player_type_number")
}

model fp_setting {
  id        Int       @id @default(autoincrement())
  player    Int
  type      String    @db.VarChar(255)
  value     String?   @db.Text
  fp_player fp_player @relation(fields: [player], references: [id], onUpdate: Restrict, map: "fp_setting_ibfk_1")

  @@unique([player, type], map: "player")
}

model fp_time {
  id        Int       @id @default(autoincrement())
  player    Int       @unique(map: "player")
  first     BigInt
  last      BigInt
  total     BigInt
  sessions  Int       @default(0)
  fp_player fp_player @relation(fields: [player], references: [id], onUpdate: Restrict, map: "fp_time_ibfk_1")

  @@index([total], map: "idx_fp_time_total")
}

model fp_version {
  id   Int    @id
  name String @db.MediumText
}

// ─── Towny (DuckBurg) ───────────────────────────────────────────────────────
// Lives in a separate database, connected via withDb("duckburg_towns", ...)
// (DATABASE_URL_DUCKBURG_TOWNS). References between these tables are plain
// UUID strings (no DB-level foreign keys), so joins are done in raw SQL.

model TOWNY_TOWNS {
  name                String  @id @db.VarChar(32)
  mayor               String? @db.LongText
  nation              String? @db.LongText
  townBoard           String? @db.LongText
  tag                 String? @db.LongText
  founder             String? @db.LongText
  protectionStatus    String? @db.LongText
  bonus               Int?    @default(0)
  purchased           Int?    @default(0)
  taxpercent          Boolean @default(false)
  maxPercentTaxAmount Float?  @db.Float
  taxes               Float?  @default(0) @db.Float
  hasUpkeep           Boolean @default(false)
  plotPrice           Float?  @db.Float
  plotTax             Float?  @db.Float
  commercialPlotPrice Float?  @db.Float
  commercialPlotTax   Float   @db.Float
  embassyPlotPrice    Float   @db.Float
  embassyPlotTax      Float   @db.Float
  open                Boolean @default(false)
  public              Boolean @default(false)
  adminEnabledMobs    Boolean @default(false)
  admindisabledpvp    Boolean @default(false)
  adminenabledpvp     Boolean @default(false)
  allowedToWar        Boolean @default(true)
  homeblock           String  @db.LongText
  spawn               String  @db.LongText
  outpostSpawns       String? @db.LongText
  outlaws             String? @db.LongText
  uuid                String? @db.VarChar(36)
  registered          BigInt?
  spawnCost           Float   @db.Float
  mapColorHexCode     String? @db.LongText
  metadata            String? @db.LongText
  conqueredDays       Int?    @db.MediumInt
  conquered           Boolean @default(false)
  ruined              Boolean @default(false)
  ruinedTime          BigInt? @default(0)
  neutral             Boolean @default(false)
  debtBalance         Float   @db.Float
  joinedNationAt      BigInt
  primaryJail         String? @db.VarChar(36)
  movedHomeBlockAt    BigInt
  trustedResidents    String? @db.LongText
  trustedTowns        String  @db.LongText
  nationZoneOverride  Int?    @default(0)
  nationZoneEnabled   Boolean @default(true)
  allies              String  @db.LongText
  enemies             String  @db.LongText
  hasUnlimitedClaims  Boolean @default(false)
  manualTownLevel     BigInt? @default(-1)
  forSale             Boolean @default(false)
  forSalePrice        Float   @db.Float
  forSaleTime         BigInt? @default(0)
  visibleOnTopLists   Boolean @default(true)
  hasActiveWar        Boolean @default(false)
}

model TOWNY_NATIONS {
  name                String  @id @db.VarChar(32)
  capital             String  @db.LongText
  tag                 String  @db.LongText
  allies              String  @db.LongText
  enemies             String  @db.LongText
  taxes               Float   @db.Float
  taxpercent          Boolean @default(false)
  maxPercentTaxAmount Float?  @db.Float
  spawnCost           Float   @db.Float
  neutral             Boolean @default(false)
  uuid                String? @db.VarChar(36)
  registered          BigInt?
  nationBoard         String? @db.LongText
  mapColorHexCode     String? @db.LongText
  nationSpawn         String? @db.LongText
  isPublic            Boolean @default(true)
  isOpen              Boolean @default(true)
  metadata            String? @db.LongText
  conqueredTax        Float   @db.Float
  sanctionedTowns     String? @db.LongText
  hasActiveWar        Boolean @default(false)
  manualNationLevel   BigInt? @default(-1)
}

model TOWNY_RESIDENTS {
  name             String  @id @db.VarChar(32)
  town             String? @db.LongText
  town_ranks       String? @map("town-ranks") @db.LongText
  nation_ranks     String? @map("nation-ranks") @db.LongText
  lastOnline       BigInt
  registered       BigInt
  joinedTownAt     BigInt
  isNPC            Boolean @default(false)
  jailUUID         String? @db.VarChar(36)
  jailCell         Int?    @db.MediumInt
  jailHours        Int?    @db.MediumInt
  jailBail         Float?  @db.Float
  title            String? @db.LongText
  surname          String? @db.LongText
  protectionStatus String? @db.LongText
  friends          String? @db.LongText
  metadata         String? @db.LongText
  uuid             String  @db.VarChar(36)
  about            String? @db.LongText
}

model TOWNY_TOWNBLOCKS {
  world                 String  @db.VarChar(36)
  x                     Int     @db.MediumInt
  z                     Int     @db.MediumInt
  name                  String? @db.LongText
  price                 Float?  @default(-1) @db.Float
  taxed                 Boolean @default(true)
  town                  String? @db.LongText
  resident              String? @db.LongText
  type                  Int     @default(0) @db.TinyInt
  typeName              String? @db.LongText
  outpost               Boolean @default(false)
  permissions           String  @db.LongText
  locked                Boolean @default(false)
  changed               Boolean @default(false)
  metadata              String? @db.LongText
  groupID               String? @db.VarChar(36)
  districtID            String? @db.VarChar(36)
  claimedAt             BigInt
  trustedResidents      String? @db.LongText
  customPermissionData  String? @db.LongText
  minTownMembershipDays Int     @default(-1) @db.SmallInt
  maxTownMembershipDays Int     @default(-1) @db.SmallInt

  @@id([world, x, z])
}

// ─── FlectoneGrowth / "newbie" (DuckBurg) ──────────────────────────────────
// Lives in a separate database, connected via withDb("duckburg_newbie", ...)
// (DATABASE_URL_DUCKBURG_NEWBIE). Only actively tracks newer players — most
// rows in flectonegrowth_player have no matching genders/growth_time/scales
// row at all, which just means that player isn't tracked by this system.

model flectonegrowth_player {
  id                         Int                         @id @default(autoincrement())
  uuid                       String                      @unique(map: "uuid") @db.VarChar(36)
  username                   String?                     @db.VarChar(16)
  flectonegrowth_genders     flectonegrowth_genders?
  flectonegrowth_growth_time flectonegrowth_growth_time?
  flectonegrowth_playtime    flectonegrowth_playtime[]
  flectonegrowth_scales      flectonegrowth_scales?
}

model flectonegrowth_genders {
  gender_key             String                @default("male") @db.VarChar(32)
  valid                  Boolean               @default(true)
  player_id              Int                   @id
  flectonegrowth_player  flectonegrowth_player @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "fk_flectonegrowth_genders_player")
}

model flectonegrowth_growth_time {
  growth_seconds         BigInt
  valid                  Boolean               @default(true)
  player_id              Int                   @id
  flectonegrowth_player  flectonegrowth_player @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "fk_flectonegrowth_growth_time_player")
}

model flectonegrowth_playtime {
  server                  String                @default("") @db.VarChar(64)
  first_seen              BigInt
  last_seen               BigInt
  total_seconds           BigInt                @default(0)
  sessions                Int                   @default(0)
  player_id               Int
  flectonegrowth_player   flectonegrowth_player @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "fk_flectonegrowth_playtime_player")

  @@id([player_id, server])
}

model flectonegrowth_scales {
  scale                   Float
  valid                   Boolean               @default(true)
  player_id               Int                   @id
  flectonegrowth_player   flectonegrowth_player @relation(fields: [player_id], references: [id], onUpdate: Restrict, map: "fk_flectonegrowth_scales_player")
}

// ─── SkinRestorer (DuckBurg) ────────────────────────────────────────────────
// Lives in a separate database, connected via withDb("duckburg_skinrestorer",
// ...) (DATABASE_URL_DUCKBURG_SKINRESTORER). `value` is a base64-encoded
// Mojang session-server profile blob containing the actual skin texture URL.

model sr_player_skins {
  uuid            String  @id @db.VarChar(36)
  last_known_name String? @db.VarChar(16)
  value           String  @db.MediumText
  signature       String  @db.MediumText
  timestamp       BigInt
}

// ─── LuckPerms (network-wide, shared by the whole proxy setup) ─────────────
// One LuckPerms install shared across the Velocity proxy and every backend
// server — not DuckBurg-specific like Towny/FlectoneGrowth/SkinRestorer, so
// this uses its own top-level withDb("luckperms", ...) key
// (DATABASE_URL_LUCKPERMS), the same "no server prefix" pattern as the
// default FlectonePulse (fp_*) database. Table names/columns confirmed live
// against the real database (`lp_` prefix, not the `luckperms_` this repo
// originally guessed) — group membership is `group.<name>` permission nodes
// in lp_user_permissions (LuckPerms has no separate "group membership"
// table); lp_tracks DOES store each track's ordered group list as a JSON
// array (contrary to the assumption that tracks are config-file-only), so
// track structure/order is read live from here rather than mirrored by
// hand in the site DB — only display metadata (name/icon/color per group)
// lives there (LuckPermsRole in src/prisma/site/schema.prisma.template).

model lp_user_permissions {
  id         Int     @id @default(autoincrement())
  uuid       String  @db.VarChar(36)
  permission String  @db.VarChar(200)
  value      Boolean @default(true)
  server     String  @default("global") @db.VarChar(36)
  world      String  @default("global") @db.VarChar(64)
  expiry     BigInt  @default(0)
  contexts   String  @default("{}") @db.VarChar(200)

  @@index([uuid])
}

/// `groups` is a JSON array of group names as a single TEXT column
/// (`["support","moderator","admin"]`), ordered lowest -> highest rank —
/// not a normalized join table. Read with JSON_TABLE or parsed in JS after
/// a plain SELECT; either way, this is LuckPerms' own data, never written
/// to from this app.
model lp_tracks {
  name   String @id @db.VarChar(36)
  groups String @db.Text
}

/// The full group catalog — every group LuckPerms knows about, including
/// ones that aren't a member of any track (e.g. "supporter", a perk group
/// with no ranked progression) and ones nobody currently holds. This is
/// what /admin/ranks offers as suggestions when curating a role's display,
/// rather than only groups derived from lp_tracks or already-configured
/// roles (which would miss exactly the standalone case this table exists
/// to cover).
model lp_groups {
  name String @id @db.VarChar(36)
}
