// Site-owned data: user accounts and Minecraft-account linking. Lives in its
// own database (DATABASE_URL_SITE) — separate from every plugin database
// this app otherwise only reads from via src/lib/db.ts's withDb(). Unlike
// those, this schema is the source of truth (migrated with `prisma migrate
// dev --schema=src/prisma/site/schema.prisma`), so it gets its own generated
// client instead of sharing the multi-datasource client in src/prisma/schema.prisma.
//
// This is a TEMPLATE, not the schema Prisma reads directly — schema.prisma
// itself is generated from this file by scripts/render-site-schema.js (run
// via `npm run site-db:render`, or automatically before every site-db:* /
// postinstall command), substituting the prefix placeholder below with
// SITE_DB_TABLE_PREFIX from .env (e.g. "site_"). Prisma's @@map has no way
// to reference an env var directly, so this templating step exists purely
// to make the table prefix configurable without hand-editing every @@map.
// Edit THIS file, not the generated schema.prisma.

generator client {
  provider = "prisma-client-js"
  // Generated into node_modules/.prisma (matching the default client's own
  // location) rather than a project folder — Next.js's build tracer treats
  // that location leniently; a project-local path made it trace and bundle
  // the entire repo into the standalone server output (see git history if
  // this ever needs revisiting).
  output   = "../../../node_modules/.prisma/site-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_SITE")
}

model User {
  id                  String               @id @default(uuid())
  nickname            String               @unique @db.VarChar(32)
  passwordHash        String               @db.VarChar(255)
  isAdmin             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  // Persisted floor for "last seen on the site" — updated at most once per
  // PERSIST_MIN_INTERVAL_MS by src/lib/presence.ts, not on every heartbeat.
  // "Online right now" is served from that module's in-memory map instead of
  // this column, which only exists so an offline user still shows a
  // meaningful last-seen time (and so presence survives a process restart,
  // if briefly stale by up to that interval).
  lastSeenAt          DateTime?
  accountLink         AccountLink?
  tickets             Ticket[]
  ticketMessages      TicketMessage[]
  passwordResetTokens PasswordResetToken[]
  badges              UserBadge[]

  @@map("{{PREFIX}}user")
}

/// A profile award, shown next to a user's name. Rows can come from either
/// side of the app: seedBuiltinBadges() (src/lib/badges.ts) upserts the
/// code-defined catalog in src/config/badges.ts by `key` on demand — it
/// never overwrites a row that already exists, so an admin's edits to a
/// built-in badge stick across deploys — and the admin panel's own CRUD at
/// /admin/badges creates rows the same way, just without a code-defined
/// `key` counterpart. `icon` is a lucide-react icon name (validated against
/// BADGE_ICON_NAMES in src/config/badges.ts, not free text) so it renders
/// as a real SVG component, not raw user-controlled markup.
model Badge {
  id            String   @id @default(uuid())
  key           String   @unique @db.VarChar(64)
  name          String   @db.VarChar(64)
  description   String?  @db.VarChar(255)
  // How to earn it (e.g. "Awarded to the first 50 registered players") —
  // deliberately separate from `description` (what the badge represents)
  // so the hover tooltip can show both distinctly. Optional: plenty of
  // badges (admin-discretion awards especially) have no fixed condition.
  // Free text only — display, never evaluated. autoConditionRoleId below is
  // the one machine-readable auto-earn condition that actually exists.
  earnCondition String?  @db.VarChar(255)
  icon          String   @db.VarChar(64)
  color         String?  @db.VarChar(16)
  createdAt     DateTime @default(now())
  userBadges    UserBadge[]

  // Zero or more LuckPerms roles that auto-grant this badge — a player
  // holding ANY of them qualifies (e.g. one "Staff" badge triggered by
  // moderator OR admin OR support, not a separate badge per rank). Checked
  // by evaluateAutoBadges() (src/lib/luckperms.ts) lazily whenever the
  // linked account's own profile page loads (no cron/worker in this
  // codebase).
  autoRoles BadgeAutoRole[]

  @@map("{{PREFIX}}badge")
}

/// Join row for the N:N between User and Badge — a user can hold many
/// badges, a badge can be held by many users. awardedAt tracks when the
/// admin (or code) granted this specific one.
model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())
  // Shown next to this user's name on the leaderboard (see
  // /api/leaderboard and BadgePinSelector). Lives on the join row rather
  // than as a single FK on User specifically so this can loosen from "at
  // most one pinned per user" to "several" later without a schema change —
  // for now setPinnedBadge() enforces the one-pinned rule at the app level,
  // not here. Deleting the UserBadge row (revoke) naturally un-pins it too,
  // nothing extra to clean up on that path.
  pinned    Boolean  @default(false)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("{{PREFIX}}user_badge")
}

/// Admin-configured display metadata for one LuckPerms group — name/icon/
/// color to show when a player currently holds it, nothing else. Track
/// membership and rank (which track a group belongs to, and whether it's
/// the highest one a player holds) are read live from LuckPerms' own
/// lp_tracks table (src/prisma/schema.prisma) instead of being duplicated
/// here by hand — lp_tracks.groups is already an ordered array per track,
/// so this table only needs to answer "how should group X look as a
/// badge", not "which track is X in" or "where does X rank". `group` is
/// free text (not an FK) since LuckPerms' own group names live in a
/// different database entirely.
model LuckPermsRole {
  id        String   @id @default(uuid())
  group     String   @unique @db.VarChar(64)
  name      String   @db.VarChar(64)
  icon      String   @db.VarChar(64)
  color     String?  @db.VarChar(16)
  createdAt DateTime @default(now())
  autoRoleFor BadgeAutoRole[]

  @@map("{{PREFIX}}luckperms_role")
}

/// Join row for the N:N between Badge and LuckPermsRole (a badge's
/// "auto-grant if the player holds any of these roles" set). Deleting the
/// role definition (/admin/roles) or the badge itself cascades here — an
/// orphaned link isn't meaningful in either direction, unlike
/// UserBadge/User where the award record has its own standalone value.
model BadgeAutoRole {
  id      String        @id @default(uuid())
  badgeId String
  badge   Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  roleId  String
  role    LuckPermsRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([badgeId, roleId])
  @@index([badgeId])
  @@index([roleId])
  @@map("{{PREFIX}}badge_auto_role")
}

enum LinkStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

/// One row per site user's Minecraft-account link. A fresh /link request
/// reuses this row (reset back to PENDING with a new code) rather than
/// creating a new one, since a site user only ever has one linked account.
/// Table/column contract is shared with the Minecraft-side plugin — see
/// MINECRAFT_ACCOUNT_LINK.md if you change this model.
model AccountLink {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String     @unique @db.VarChar(16)
  // Both null until confirmed — the site never asks for a Minecraft
  // nickname; the plugin captures the player's real name + UUID at the
  // moment they run /link <code> in-game.
  minecraftName String?    @db.VarChar(16)
  minecraftUuid String?    @unique @db.VarChar(36)
  status        LinkStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  expiresAt     DateTime
  confirmedAt   DateTime?

  @@index([status])
  @@map("{{PREFIX}}account_link")
}

/// One row per (server, BetonQuest package) — the raw contents of that
/// package's YAML files (package.yml, conditions.yml, objectives.yml,
/// actions.yml, conversations/*.yml, ...) as reported by the BetonQuestApi
/// Paper plugin running on that server, relayed through the
/// DuckTaleQuestProxy Velocity plugin. `files` is a JSON object mapping
/// each file's path (relative to the package folder, e.g. "conditions.yml"
/// or "conversations/Instructor.yml") to its raw text content — nothing
/// here is parsed or interpreted; turning this into a quest graph
/// (conditions, prerequisites, NPC dialogue structure) is the website's
/// job. `server` is whatever name that server is registered under in the
/// proxy's velocity.toml, not anything the backend plugin's own config
/// claims to be called. Table/column contract is shared with the
/// Minecraft-side plugins — see BETONQUEST_QUEST_TREE.md if you change
/// this model.
model QuestCatalog {
  id          String   @id @default(uuid())
  server      String   @db.VarChar(64)
  packageName String   @db.VarChar(190)
  files       Json
  updatedAt   DateTime @updatedAt

  @@unique([server, packageName])
  @@map("{{PREFIX}}quest_catalog")
}

/// One row per (server, Citizens NPC id) — that NPC's real display name
/// and the Minecraft username its skin was borrowed from, read from
/// Citizens' own saves.yml by the BetonQuestApi plugin (BetonQuest's
/// package.yml only ever says "citizens N", an id with no name/skin of
/// its own) and relayed through DuckTaleQuestProxy. `skinSourceName` is
/// pulled out of the NPC's stored skin texture profile (its
/// "profileName") — a real Mojang username suitable for a minotar.net (or
/// similar) lookup, not necessarily who's "really" behind the NPC
/// narratively, just whose skin got borrowed for it. Nullable: an NPC can
/// have no skin trait set (default Steve/Alex). Table/column contract is
/// shared with the Minecraft-side plugins — see BETONQUEST_QUEST_TREE.md
/// if you change this model.
model NpcIdentity {
  id             String   @id @default(uuid())
  server         String   @db.VarChar(64)
  npcId          Int
  name           String   @db.VarChar(64)
  skinSourceName String?  @db.VarChar(32)
  updatedAt      DateTime @updatedAt

  @@unique([server, npcId])
  @@map("{{PREFIX}}npc_identity")
}

/// Issued by an admin from the users panel and handed to the user
/// out-of-band (Discord/Telegram) as a one-time link, replacing the old
/// flow where the admin saw and shared a plaintext random password
/// directly. usedAt is set the moment the linked page is submitted, and a
/// fresh admin-issued token deletes any previous ones for the same user —
/// only the most recently issued link is ever valid.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("{{PREFIX}}password_reset_token")
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A support ticket opened by a site user from their profile. Any admin can
/// see and reply to any ticket; the owning user only sees/replies to their
/// own (see canViewTicket() in src/lib/tickets.ts). `status` tracks whose
/// turn it is to respond rather than a resolution stage — sendTicketMessage()
/// flips it to ANSWERED on an admin reply and back to OPEN on a user reply
/// (which also reopens a CLOSED ticket), while CLOSED only ever comes from
/// an explicit admin action.
model Ticket {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String          @db.VarChar(120)
  status    TicketStatus    @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  TicketMessage[]

  @@index([userId])
  @@index([status, updatedAt])
  @@map("{{PREFIX}}ticket")
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isAdminReply Boolean            @default(false)
  body         String             @db.Text
  createdAt    DateTime           @default(now())
  attachments  TicketAttachment[]

  @@index([ticketId])
  @@map("{{PREFIX}}ticket_message")
}

model TicketAttachment {
  id              String        @id @default(uuid())
  ticketMessageId String
  ticketMessage   TicketMessage @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)
  filename        String        @db.VarChar(255)
  size            Int
  mimeType        String        @db.VarChar(100)
  path            String        @db.VarChar(512)
  createdAt       DateTime      @default(now())

  @@index([ticketMessageId])
  @@map("{{PREFIX}}ticket_attachment")
}
